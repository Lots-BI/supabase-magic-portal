{
  "version": "1.0.0",
  "key": "instagram_organic",
  "kind": "platform",
  "label": "Instagram",
  "category": "organic",
  "capabilities": ["instagram_organic:metrics:collect", "instagram_organic:profile:collect"],
  "metrics": [
    { "key": "views", "format": "int", "official": true },
    { "key": "reach", "format": "int", "official": true },
    { "key": "likes", "format": "int", "official": true },
    { "key": "comments", "format": "int", "official": true },
    { "key": "saves", "format": "int", "official": true },
    { "key": "shares", "format": "int", "official": true },
    { "key": "total_interactions", "format": "int", "official": true }
  ],
  "oauth": {
    "type": "oauth2_meta",
    "scopes": [
      "instagram_basic",
      "instagram_manage_insights",
      "pages_read_engagement",
      "pages_show_list",
      "business_management"
    ]
  },
  "providers": {
    "default": "make_passive",
    "supported": ["make_passive", "official_api"]
  },
  "publisher": {
    "supported": false
  },
  "identity": {
    "types": ["instagram", "page"],
    "primary": "instagram"
  },
  "health": {
    "evaluators": ["generic-freshness"]
  },
  "versions": [
    { "provider": "make_passive", "apiVersion": "v1" },
    { "provider": "official_api", "apiVersion": "v22.0" }
  ],
  "ingestProfiles": ["entity-upsert", "metrics-timeseries"]
}
